# Reference deployment environment for server/deploy/reference/compose.yaml.
#
# Copy this file to .env and fill in every REQUIRED value below. Compose
# refuses to start while a required value is missing or empty — there are no
# working default credentials.

TOOLPLANE_IMAGE=toolplane-reference:latest

# --- REQUIRED: database credentials ---------------------------------------
# Choose a real password (e.g. `openssl rand -hex 24`) and embed the same
# password in TOOLPLANE_DATABASE_URL.
POSTGRES_USER=toolplane
POSTGRES_PASSWORD=
POSTGRES_DB=toolplane
TOOLPLANE_DATABASE_URL=

# --- REQUIRED (bootstrap profile only): one-time admin token ---------------
# Fixed-mode keys bypass session binding, so this token grants full
# cross-session admin while the bootstrap profile runs. Generate a one-time
# value (e.g. `openssl rand -hex 32`), use it to provision real API keys,
# then stop the bootstrap profile.
TOOLPLANE_BOOTSTRAP_FIXED_API_KEY=

# --- Optional: published ports ---------------------------------------------
# Postgres and metrics are bound to 127.0.0.1 by default (host-local only).
TOOLPLANE_POSTGRES_PUBLISHED_PORT=5432
TOOLPLANE_GRPC_PUBLISHED_PORT=9001
TOOLPLANE_HTTP_PUBLISHED_PORT=8080
TOOLPLANE_MCP_PUBLISHED_PORT=8081
TOOLPLANE_METRICS_PUBLISHED_PORT=9102
TOOLPLANE_BOOTSTRAP_HTTP_PUBLISHED_PORT=18080

# --- Optional: TLS material --------------------------------------------------
TOOLPLANE_SERVER_TLS_CERT_PATH=./certs/server.crt
TOOLPLANE_SERVER_TLS_KEY_PATH=./certs/server.key
TOOLPLANE_PROXY_BACKEND_TLS_CA_PATH=./certs/ca.crt
TOOLPLANE_MCP_BACKEND_TLS_CA_PATH=./certs/ca.crt

# --- Optional: edge configuration --------------------------------------------
TOOLPLANE_PROXY_ALLOWED_ORIGINS=https://app.example.com
TOOLPLANE_PROXY_BACKEND_TLS_SERVER_NAME=server

# MCP gateway (MCP 2026-07-28 JSON-RPC facade over the gRPC backend).
TOOLPLANE_MCP_ALLOWED_ORIGINS=https://app.example.com
TOOLPLANE_MCP_BACKEND_TLS_SERVER_NAME=server

TOOLPLANE_PROXY_API_RATE=25
TOOLPLANE_PROXY_API_BURST=50
TOOLPLANE_PROXY_IP_RATE=100
TOOLPLANE_PROXY_IP_BURST=200
